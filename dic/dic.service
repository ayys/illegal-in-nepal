[Unit]
Description=Dictionary API and preview images for illegal-in-nepal.org
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/opt/dic/dic
Environment=DIC_FONTS=/opt/dic/fonts
DynamicUser=yes
CacheDirectory=dic
Restart=on-failure
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
