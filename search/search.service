[Unit]
Description=Dictionary search API for illegal-in-nepal.org
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/opt/search/search
DynamicUser=yes
Restart=on-failure
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
